# ═══════════════════════════════════════════════════════════════════════════
# SACS Payroll environment. Copy to .env.local for local work.
# Production: set the "HOST" variables in the hosting dashboard (Vercel →
# Settings → Environment Variables, Production scope). Never commit real
# values; .env.local is git-ignored.
# Production values must come from the production Supabase project and the
# school's own Gmail account, never from a test project or test inbox.
# ═══════════════════════════════════════════════════════════════════════════

# ── HOST: required ──────────────────────────────────────────────────────────

# Supabase Project URL, the bare origin https://<ref>.supabase.co (NOT the
# .../rest/v1/ endpoint). Public. Used by every API route and the scripts.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (publishable) key. Public by design: used server-side to
# check passwords (legacy-auth/login, change-password, verify-password).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role (secret) key. SERVER ONLY: bypasses Row Level
# Security. Used by every API route (src/lib/supabase/admin.js) and scripts.
SUPABASE_SERVICE_ROLE_KEY=
# Signs the HttpOnly session cookie (src/lib/rbac/session.js) and hashes
# issued temporary passwords (src/lib/auth/password-policy.js). REQUIRED in
# production (sign-in fails without it); outside production it falls back to
# SUPABASE_SERVICE_ROLE_KEY. A long random string, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
SESSION_SECRET=
# Outgoing email for sign-in, password reset and password change codes
# (Gmail SMTP, src/lib/mail/gmail.js). SERVER ONLY. GMAIL_APP_PASSWORD is a
# Google App Password (Google Account → Security → 2-Step Verification →
# App passwords), NOT the account's real password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── HOST: optional ──────────────────────────────────────────────────────────

# Sender name shown in the inbox (src/lib/mail/gmail.js). Default "SACS Payroll".
MAIL_FROM_NAME=SACS Payroll
# Checks new passwords against the Have I Been Pwned range API
# (src/lib/auth/breached-password.js). Empty = on (off under the test
# runner); "off" disables it.
PASSWORD_BREACH_CHECK=

# Error monitoring with Sentry, free plan (docs/monitoring.md). Off while
# empty. SENTRY_DSN: server errors (src/instrumentation.js);
# NEXT_PUBLIC_SENTRY_DSN: browser errors (src/instrumentation-client.js),
# baked in at build time, so redeploy after setting it. Same DSN for both.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: readable stack traces (source maps uploaded at build time).
# SENTRY_AUTH_TOKEN is SECRET (mark Sensitive on the host).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Username sign-in shortcuts (src/app/api/legacy-auth/login/route.js): typing
# SEED_<ROLE>_USERNAME at sign-in signs in to SEED_<ROLE>_EMAIL. Only set
# these on the host if the school wants a username for its Super Admin /
# Admin / HR accounts; otherwise staff sign in with their email.
# SEED_SUPER_ADMIN_USERNAME=  SEED_SUPER_ADMIN_EMAIL=
# SEED_ADMIN_USERNAME=        SEED_ADMIN_EMAIL=
# SEED_HR_USERNAME=           SEED_HR_EMAIL=

# ── LOCAL / SCRIPTS ONLY: never set on the host ─────────────────────────────

# Development only: read code emails from mail.tm test inboxes
# (src/lib/mail/mailtm.service.mjs, /api/dev/mailtm). Ignored when
# NODE_ENV=production. Leave unset or false on the host.
USE_MAILTM=false

# Default accounts created by `npm run supabase:seed-users`
# (scripts/seed-auth-users.mjs) and kept by scripts/clean-reset.mjs. Test
# accounts: never put these passwords on the host.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_HR_EMAIL=
SEED_HR_PASSWORD=
SEED_HR_USERNAME=
SEED_HR_EMPLOYEE_ID=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
SEED_ACCOUNTANT_EMPLOYEE_ID=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_LOGIN_ID=

# Database backups (npm run db:backup, scripts/backup/backup-db.mjs): the
# Session pooler connection string from Dashboard → Connect, with the
# database password. Never on the host.
SUPABASE_DB_URL=

# scripts/clean-reset.mjs refuses these project refs (comma-separated) in
# addition to the built-in live ref (scripts/clean-reset-guard.mjs).
SUPABASE_LIVE_PROJECT_REFS=

# Supabase CLI / MCP (docs/local-migration-replay.md). Set in your user
# environment, not in this file.
# SUPABASE_ACCESS_TOKEN=

# Edge Function attendance-nightly gets SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY from Supabase automatically; nothing to set.
