NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Signs the HttpOnly RBAC session cookie (src/lib/rbac/session.js).
# Optional: falls back to SUPABASE_SERVICE_ROLE_KEY when unset. Set it to
# a long random string so rotating the Supabase key does not sign users out.
SESSION_SECRET=
# Base URL password-reset links point back to, e.g. https://payroll.example.com
# (no trailing slash). Set this in production: it replaces the request's Origin
# header, which a caller can forge to redirect reset tokens to their own site.
# Leave blank and Supabase falls back to the project's configured Site URL.
APP_URL=
# Optional comma-separated extra origins allowed to serve reset links, for
# deployments reachable on more than one hostname.
APP_URL_ALLOWLIST=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_HR_EMAIL=
SEED_HR_PASSWORD=
SEED_HR_USERNAME=
SEED_HR_EMPLOYEE_ID=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
SEED_ACCOUNTANT_EMPLOYEE_ID=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_LOGIN_ID=
