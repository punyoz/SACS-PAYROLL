NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Signs the HttpOnly RBAC session cookie (src/lib/rbac/session.js).
# REQUIRED in production (sign-in fails without it). Outside production it
# falls back to SUPABASE_SERVICE_ROLE_KEY. Set it to a long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
SESSION_SECRET=
# Outgoing email (sign-in, password reset and password change codes) through
# Gmail SMTP, src/lib/mail/gmail.js. Server-only: never prefix with NEXT_PUBLIC_.
# GMAIL_APP_PASSWORD is a Google App Password (Google Account -> Security ->
# 2-Step Verification -> App passwords), NOT the account's real password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional sender name shown in the inbox (default "SACS Payroll").
MAIL_FROM_NAME=SACS Payroll
# Development/testing only: read the code emails from mail.tm test inboxes
# (src/lib/mail/mailtm.service.mjs, /api/dev/mailtm). Ignored when
# NODE_ENV=production, whatever it is set to. Leave false in deployments.
USE_MAILTM=false
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_HR_EMAIL=
SEED_HR_PASSWORD=
SEED_HR_USERNAME=
SEED_HR_EMPLOYEE_ID=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
SEED_ACCOUNTANT_EMPLOYEE_ID=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_LOGIN_ID=
