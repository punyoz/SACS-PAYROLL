NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Signs the HttpOnly RBAC session cookie (src/lib/rbac/session.js).
# REQUIRED in production (sign-in fails without it). Outside production it
# falls back to SUPABASE_SERVICE_ROLE_KEY. Set it to a long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
SESSION_SECRET=
# No longer read. Password reset is now an 8-digit email OTP
# (POST /api/legacy-auth/reset-password), so no reset links are built.
# Safe to leave blank.
APP_URL=
APP_URL_ALLOWLIST=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_HR_EMAIL=
SEED_HR_PASSWORD=
SEED_HR_USERNAME=
SEED_HR_EMPLOYEE_ID=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_PASSWORD=
SEED_ACCOUNTANT_EMPLOYEE_ID=
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_LOGIN_ID=
