{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/awol-notices",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/demo-taps?run=early",
      "schedule": "0 23 * * 4"
    },
    {
      "path": "/api/cron/demo-taps?run=in",
      "schedule": "0 0 * * 1-5"
    },
    {
      "path": "/api/cron/demo-taps?run=out",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/cron/recompute-period",
      "schedule": "30 16 * * 4"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "release*/**": false,
      "feat/**": false,
      "fix/**": false,
      "followup*/**": false,
      "docs/**": false,
      "e2e/**": false,
      "test/**": false
    }
  }
}
